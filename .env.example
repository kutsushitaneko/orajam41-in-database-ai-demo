# Copy to .env. Do not commit real values. Use forward slashes in Windows paths.
# OCI API signing key authentication (not a GenAI bearer API key).
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
OCI_KEY_FILE=
OCI_KEY_PASSPHRASE=
OCI_REGION=
OCI_ADB_OCID=
OCI_ADB_REGION=
OCI_ADB_COMPARTMENT_OCID=
OCI_GENAI_REGION=
OCI_GENAI_COMPARTMENT_OCID=
OCI_GENAI_MODEL_ID=
OCI_GENAI_ENDPOINT=
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_MODEL_BUCKET=
OCI_MODEL_REGION=ap-tokyo-1
OCI_MODEL_COMPARTMENT_OCID=
OCI_MODEL_PREFIX=
OCI_MODEL_ONNX_URI=
# Optional bulk destination; blank uses OCI_MODEL_REGION / OCI_MODEL_BUCKET.
OCI_BULK_REGION=
OCI_BULK_BUCKET=
# Database credentials are separate from OCI API key authentication.
DB_NAME=arakawalab
DB_USER=orajam41user
DB_PASSWORD=
DB_ADMIN_USER=ADMIN
DB_ADMIN_PASSWORD=
# TLS connect descriptor, or a tnsnames alias with DB_CONFIG_DIR configured.
DB_DSN=
DB_CONFIG_DIR=
DB_WALLET_DIR=
DB_WALLET_PASSWORD=

# Optional Osaka Cohere Embed 4 latency evaluation (keeps chat settings unchanged).
OCI_EMBED_REGION=ap-osaka-1
OCI_EMBED_MODEL_ID=cohere.embed-v4.0
